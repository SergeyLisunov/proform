{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/digest/daily",                   "schedule": "0 4 * * *" },
    { "path": "/api/digest/weekly",                  "schedule": "0 17 * * 0" },
    { "path": "/api/cron/expire-recommendations",    "schedule": "0 3 * * *" },
    { "path": "/api/cron/expire-stale-pending",      "schedule": "0 5 * * *" },
    { "path": "/api/cron/leads-digest",              "schedule": "0 8 * * 1" },
    { "path": "/api/cron/expire-inquiries",          "schedule": "0 6 * * *" },
    { "path": "/api/cron/adherence-nudge",           "schedule": "0 9 * * *" }
  ]
}
