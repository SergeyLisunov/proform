# ProForm — environment variables (.env.local for dev, Vercel for prod)
# Copy this file to `.env.local` and fill in the values, or set them in
# Vercel → Project Settings → Environment Variables for production.

# ────────────────────────────────────────────────────────────────────────────
# CORE — REQUIRED. Without these the app can't authenticate or read DB.
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service-role key — bypasses RLS, used only in server-side API routes:
#   email digests, /api/invite, Whoop callback, Apple-Health upload,
#   referral grant_referral_credit RPC.
# NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Public app URL for OAuth callbacks, magic-link redirects, OG meta.
# In dev: http://localhost:3000. In prod: your Vercel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# CHAT-ASSISTANT — Gemma 4 через Ollama Cloud (виджет + /ai).
# Ключ ТОЛЬКО серверный (route handler /api/ai/chat) — никогда не
# NEXT_PUBLIC_*. Без ключа чат отвечает 503 «AI-ассистент не настроен».
# Модель закреплена в коде: gemma4:31b (алиас :cloud не использовать —
# может молча переехать). Тарификация подписочная, лимиты по частоте —
# на нашей стороне enforceAiRateLimit 30 запросов/час на пользователя.
# ────────────────────────────────────────────────────────────────────────────
OLLAMA_API_KEY=

# Провайдер ролевых ассистентов (/assistant): 'ollama' (дефолт) | 'mock'.
# mock — детерминированные ответы без внешних вызовов и ключей: тестовый
# режим/локальная разработка. Лимиты и роли работают одинаково в обоих.
AI_ASSISTANT_PROVIDER=ollama

# ────────────────────────────────────────────────────────────────────────────
# AI — REQUIRED for /api/ai/* and /api/diary/weekly-summary.
# Without this:
#   * Adaptive plans modal returns 503 AI_NOT_CONFIGURED
#   * Coach diary AI weekly summary returns 503
#   * Workout-debrief, weekly-insights, coach-suggest — all 503
# ────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ────────────────────────────────────────────────────────────────────────────
# EMAIL — REQUIRED for digests, invites, newsletters.
# ────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=ProForm <notifications@your-domain.com>

# Cron Bearer secret. Vercel Cron jobs (daily/weekly digests) pass this
# in `Authorization: Bearer ${CRON_SECRET}` to /api/digest/*.
CRON_SECRET=generate_a_random_32_char_string

# ────────────────────────────────────────────────────────────────────────────
# BILLING — ЮKassa (Sprint W2 Day 7 → W6 Day 28: sole provider).
# Russian acquiring with native subscriptions, СБП, Mir Pay, SberPay and
# 54-ФЗ fiscalization built-in. Stripe support was removed in W6 Day 28
# (RU/CIS market focus).
#
# Without these vars: /api/webhooks/yookassa returns 401 (IP allowlist
# rejects everything since no test merchant), and /api/billing/checkout
# returns 503 YOOKASSA_NOT_CONFIGURED.
#
# Onboarding: yookassa.ru → register shop → ЭДО contract → secret key.
# Sandbox: separate test shop_id (yookassa.ru/joinups). Use a different
# webhook URL for sandbox (e.g. /api/webhooks/yookassa-test) until ready.
# ────────────────────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=
YOOKASSA_TEST_MODE=true

# ────────────────────────────────────────────────────────────────────────────
# BILLING — Альфа-Банк интернет-эквайринг (P2: основной шлюз).
# Классический REST-шлюз register.do (form-urlencoded, суммы в копейках).
# Без ключей: /api/billing/checkout → 503 ALFABANK_NOT_CONFIGURED,
# /api/webhooks/alfabank → 401 (callback без валидного checksum).
#
# Прод-URL API выдаёт поддержка банка (pay.alfabank.ru/payment/rest или
# payment.alfabank.ru/payment/rest для логинов с префиксом «r-»).
# Тестовая среда: https://alfa.rbsuat.com/payment/rest (дефолт кода);
# тестовый мерчант — по запросу в поддержку эквайринга.
#
# ALFABANK_CALLBACK_TOKEN: в ЛК шлюза включите callback-уведомления с
# «симметричным» типом подписи и сгенерируйте токен. Callback-URL:
# https://<домен>/api/webhooks/alfabank
# ────────────────────────────────────────────────────────────────────────────
ALFABANK_USERNAME=
ALFABANK_PASSWORD=
# Альтернатива паре логин/пароль:
ALFABANK_TOKEN=
ALFABANK_API_URL=https://alfa.rbsuat.com/payment/rest
ALFABANK_CALLBACK_TOKEN=
ALFABANK_RETURN_URL=
ALFABANK_TEST_MODE=true

# Default payment provider for new checkouts: 'alfabank' | 'yookassa' |
# 'manual' (admin-only). Defaults to 'alfabank' (P2).
PAYMENTS_PROVIDER=alfabank

# ────────────────────────────────────────────────────────────────────────────
# TELEGRAM BOT (P2) — зеркалирование уведомлений + линковка аккаунтов.
# Без этих vars: /api/telegram/* отвечают 503, тумблер в настройках
# показывает «бот не настроен». Токен — от @BotFather; username — имя
# бота БЕЗ @; secret — случайная строка для setWebhook secret_token.
# После деплоя один раз: curl https://api.telegram.org/bot$TOKEN/setWebhook \
#   -d url=https://<домен>/api/telegram/webhook -d secret_token=$SECRET
# Очередь шлёт /api/telegram/process-queue (CRON_SECRET) — на Hostiman
# crontab * * * * * (см. docs/deploy/HOSTIMAN.md).
# ────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Только для PM2-воркера на VPS (deploy/telegram-worker.mjs):
# TELEGRAM_MODE: webhook (дефолт) | polling — аварийный режим, когда
# входящий вебхук-трафик Telegram фильтруется (см. TELEGRAM-BOT.md).
# APP_INTERNAL_URL: адрес приложения для воркера (на VPS —
# http://127.0.0.1:3000, задан в ecosystem.config.js; до переезда можно
# указать Vercel-домен и гонять воркер против него).
TELEGRAM_MODE=webhook
# APP_INTERNAL_URL=http://127.0.0.1:3000
# TELEGRAM_QUEUE_INTERVAL_SEC=15

# Комиссия платформы для маркетплейса в базисных пунктах (250 = 2.5%).
# Учитывается леджером (coach_orders.platform_fee_amount /
# athlete_passes.platform_fee_cents); нативный сплит Альфы («Твои
# Платежи», YPMN) — отдельный продукт, подключается позже.
PLATFORM_FEE_BPS=250

# ────────────────────────────────────────────────────────────────────────────
# WEARABLE INTEGRATIONS — Optional. Each enables one provider.
# ────────────────────────────────────────────────────────────────────────────

# WHOOP OAuth 2.0 — registers Recovery, HRV, Strain, Sleep into daily_metrics.
# Without these vars: /api/integrations/whoop/start returns 503.
# Redirect URI in Whoop dev console: ${NEXT_PUBLIC_APP_URL}/api/integrations/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Garmin Health API Partner Program (OAuth 1.0a). Requires Garmin approval.
# Without these vars: /api/integrations/garmin/start returns 503 with hint.
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# AI EMBEDDINGS (OPTIONAL) — Hugging Face for diary semantic search.
# Without these: /api/diary/index and /api/diary/search degrade gracefully.
# ────────────────────────────────────────────────────────────────────────────
HF_API_TOKEN=
HF_EMBED_MODEL=intfloat/multilingual-e5-large

# ────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY (OPTIONAL) — Sentry. SDK is bundled but disabled w/o DSN.
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
